# Copy to backend/.env and fill in. Never commit the real .env file.

# Local run (uvicorn on your machine) — Postgres running on localhost
DATABASE_URL=postgresql://brian:password@localhost:5432/campusconnect

# Used to sign login tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-string
